---
/** Opens the browser's print dialog. Only shown when JavaScript runs. */
import Button from './Button.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<Button variant="secondary" data-print-button data-print-hidden hidden>{label}</Button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print-button]')) {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  }
</script>
